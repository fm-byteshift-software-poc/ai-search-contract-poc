# AI Product Search PoC — Configuration
# ======================================
# Default: Mock mode (zero cost, deterministic outputs)
LLM_PROVIDER=mock
# Options: mock | openai | claude

# Optional: API keys (only needed when LLM_PROVIDER != mock)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Search behavior tuning
SEARCH_MAX_RESULTS=10
CONFIDENCE_THRESHOLD=low
# ======================================